# Estes valores NÃO vão em .env no deploy — são secrets das Edge Functions:
#   supabase secrets set NOME=valor
# O .env local serve só para os scripts utilitários (upload de templates).

# Token que o Guru envia no corpo de cada webhook (Painel do Guru → Configurações → Webhooks)
GURU_API_TOKEN=

# Access token da API v3 da Clicksign — conta SANDBOX enquanto em desenvolvimento
CLICKSIGN_API_TOKEN=

# Sandbox durante o desenvolvimento; produção: https://app.clicksign.com/api/v3
CLICKSIGN_BASE_URL=https://sandbox.clicksign.com/api/v3

# Autenticação do signatário cliente (Etapa 3): "email" (token por e-mail no
# widget) até a Clicksign liberar o Widget Embedded para a conta + domínio;
# depois trocar para "embedded_signature"
CLICKSIGN_CLIENT_AUTH=email

# Signatário da assinatura automática (Icomm, grupo 2) — os 4 campos devem ser
# IDÊNTICOS, letra por letra, aos do Termo de Assinatura Automática assinado
# na conta Clicksign (pré-requisito do auth "auto_signature")
ICOMM_SIGNER_NAME=
ICOMM_SIGNER_EMAIL=
ICOMM_SIGNER_BIRTHDAY=  # YYYY-MM-DD
ICOMM_SIGNER_DOCUMENTATION=  # CPF formatado: 000.000.000-00

# Usados pelos scripts locais (scripts/upload-contract-templates.mjs)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Etapa 5 (pendente): credenciais do WhatsApp (Z-API)
# ZAPI_INSTANCE_ID=
# ZAPI_TOKEN=
# ZAPI_CLIENT_TOKEN=
